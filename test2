items = ["Apple", "Milk", "Bread", "Rice", "Sugar"]

items.append("Eggs")
items.append("Juice")

print("Shopping Cart:", items)

item = input("Enter item to remove: ")
if item in items:
    items.remove(item)
    print("Item removed successfully")
else:
    print("Item not found")

search = input("Enter item to check: ")

if search in items:
    print(search, "is available")
else:
    print(search, "is not available")

print("Total number of items:", len(items))

